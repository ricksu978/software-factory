{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "factory": "pwsh -NoProfile -File scripts/factory.ps1",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "bdd": "cucumber-js --import \"features/steps/**/*.ts\" --format message:reports/bdd.ndjson",
    "start:control": "node src/main.ts",
    "start:cell": "node src/cell/main.ts",
    "aspire:start": "npm --prefix aspire-apphost run aspire:start",
    "aspire:build": "npm --prefix aspire-apphost run aspire:build",
    "aspire:dev": "npm --prefix aspire-apphost run aspire:dev"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@azure/arm-appcontainers": "4.0.0",
    "@azure/identity": "4.14.1",
    "@azure/storage-blob": "12.34.0",
    "@cucumber/tag-expressions": "11.0.1",
    "@octokit/app": "16.1.4",
    "@octokit/core": "7.0.8",
    "pg": "8.23.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
