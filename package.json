{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "build": "node scripts/build-spa.ts",
    "bdd": "cucumber-js --import \"features/steps/**/*.ts\" --format message:reports/bdd.ndjson",
    "bdd:repeat": "node scripts/bdd-repeat.ts",
    "start:control": "node src/main.ts",
    "start:cell": "node src/cell/main.ts",
    "aspire:start": "npm --prefix aspire-apphost run aspire:start",
    "aspire:build": "npm --prefix aspire-apphost run aspire:build",
    "aspire:dev": "npm --prefix aspire-apphost run aspire:dev"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@azure/arm-appcontainers": "4.0.0",
    "@azure/identity": "4.14.1",
    "@azure/storage-blob": "12.34.0",
    "@hono/node-server": "2.1.6",
    "@octokit/app": "16.1.4",
    "@octokit/core": "7.0.8",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.5",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
